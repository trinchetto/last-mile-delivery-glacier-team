# Required - Main agent LLM
ANTHROPIC_API_KEY=sk-ant-...

# Optional - Main agent config
MODEL=claude-sonnet-4-5-20250929
LANGSMITH_API_KEY=lsv2_...
LANGCHAIN_PROJECT=deliveryiq
LANGCHAIN_TRACING_V2=false

# PandasAI Data Query Configuration
# LLM provider for data queries: "anthropic" or "openrouter"
PANDAS_LLM_PROVIDER=anthropic

# OpenRouter API key (required if PANDAS_LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-...
