# Anthropic API Key - Get yours at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: Main agent configuration
MODEL=claude-sonnet-4-5-20250929

# Optional: LangSmith tracing
LANGSMITH_API_KEY=lsv2_...
LANGCHAIN_PROJECT=deliveryiq
LANGCHAIN_TRACING_V2=false

# PandasAI Data Query Configuration
# LLM provider for data queries: "anthropic" or "openrouter"
PANDAS_LLM_PROVIDER=anthropic
